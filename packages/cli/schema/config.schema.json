{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CatalogConfig": {
      "additionalProperties": false,
      "dependencies": {
        "locale": ["scope"],
        "scope": ["locale"]
      },
      "description": "One validated resource catalog definition.",
      "properties": {
        "exclude": {
          "default": [],
          "description": "Project-relative patterns removed from this definition's include set.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "format": {
          "default": null,
          "description": "Optional shipped host-format override.",
          "enum": ["json"],
          "type": "string"
        },
        "include": {
          "description": "Non-empty project-relative resource membership patterns.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "locale": {
          "default": null,
          "description": "Optional path or fixed locale binding. Must be paired with scope.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "const": "path"
                },
                "pattern": {
                  "type": "string"
                }
              },
              "required": ["from", "pattern"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "const": "fixed"
                },
                "value": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["from", "value"],
              "type": "object"
            }
          ]
        },
        "scope": {
          "default": null,
          "description": "Optional exact linker-participating scope. Must be paired with locale.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["include"],
      "type": "object"
    },
    "EmptyConfig": {
      "additionalProperties": false,
      "type": "object"
    },
    "FormatterConfig": {
      "additionalProperties": false,
      "properties": {
        "ignorePatterns": {
          "default": [],
          "description": "Project-root-relative formatter ignore patterns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/FormatterMode"
            }
          ],
          "default": "standard",
          "description": "Formatting strategy. Defaults to standard."
        }
      },
      "type": "object"
    },
    "FormatterMode": {
      "enum": ["standard", "preserve"],
      "type": "string"
    },
    "MessageCatalogKeyDomain": {
      "description": "Normalized catalog-key domain token used by roots and recognizers.",
      "oneOf": [
        {
          "const": "json-pointer",
          "description": "RFC 6901 JSON Pointer.",
          "type": "string"
        },
        {
          "const": "yaml-typed-path",
          "description": "YAML Core-Schema typed path.",
          "type": "string"
        },
        {
          "const": "xliff-1.2",
          "description": "XLIFF 1.2 hierarchy.",
          "type": "string"
        },
        {
          "const": "xliff-2",
          "description": "XLIFF 2.x hierarchy.",
          "type": "string"
        }
      ]
    },
    "MessageDeliveryTargetConfig": {
      "additionalProperties": false,
      "description": "One normalized checked delivery target.",
      "properties": {
        "eagerLocales": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "type": "array",
          "uniqueItems": true
        },
        "exporter": {
          "enum": ["esm"],
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$",
          "type": "string"
        },
        "out": {
          "maxLength": 4159,
          "minLength": 1,
          "type": "string"
        },
        "placement": {
          "enum": ["duplicate"],
          "type": "string"
        }
      },
      "required": ["name", "exporter", "out"],
      "type": "object"
    },
    "MessageDynamicReferenceMode": {
      "description": "Normalized exact dynamic-reference mode.",
      "oneOf": [
        {
          "const": "compat",
          "description": "Retain conservative reachability and report non-blocking degradation.",
          "type": "string"
        },
        {
          "const": "strict",
          "description": "Treat unbounded dynamic evidence as blocking.",
          "type": "string"
        }
      ]
    },
    "MessageJsCallKind": {
      "description": "Normalized built-in JS recognizer call kind.",
      "oneOf": [
        {
          "const": "lookup",
          "description": "One ordinary message lookup.",
          "type": "string"
        },
        {
          "const": "set",
          "description": "One explicit finite set declaration.",
          "type": "string"
        }
      ]
    },
    "MessageJsKeySyntax": {
      "description": "Normalized JS source-facing key syntax.",
      "oneOf": [
        {
          "const": "canonical",
          "description": "The source string is already canonical.",
          "type": "string"
        },
        {
          "const": "literal",
          "description": "The source string is one literal JSON Pointer segment.",
          "type": "string"
        },
        {
          "const": "dot-path",
          "description": "The source string uses the fixed dot-path grammar.",
          "type": "string"
        }
      ]
    },
    "MessageJsRecognizerConfig": {
      "additionalProperties": false,
      "description": "One normalized built-in JS recognizer binding.",
      "properties": {
        "domain": {
          "$ref": "#/definitions/MessageCatalogKeyDomain"
        },
        "keySyntax": {
          "$ref": "#/definitions/MessageJsKeySyntax"
        },
        "kind": {
          "$ref": "#/definitions/MessageJsCallKind"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "scope", "domain", "keySyntax"],
      "type": "object"
    },
    "MessageProducersConfig": {
      "additionalProperties": false,
      "description": "Normalized producer declarations.",
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "js": {
          "additionalProperties": false,
          "description": "Normalized built-in JS producer configuration.",
          "properties": {
            "include": {
              "description": "Non-empty JS/TS source membership patterns.",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "recognizers": {
              "additionalProperties": {
                "$ref": "#/definitions/MessageJsRecognizerConfig"
              },
              "minProperties": 1,
              "type": "object"
            }
          },
          "required": ["include", "recognizers"],
          "type": "object"
        }
      },
      "type": "object"
    },
    "MessageRootConfig": {
      "additionalProperties": false,
      "description": "One normalized configured root.",
      "properties": {
        "domain": {
          "$ref": "#/definitions/MessageCatalogKeyDomain"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "selector": {
          "$ref": "#/definitions/MessageSelectorConfig"
        }
      },
      "required": ["scope", "domain", "selector"],
      "type": "object"
    },
    "MessageSelectorConfig": {
      "description": "Normalized configured-root selector.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One exact canonical key.",
          "properties": {
            "key": {
              "description": "Canonical key spelling.",
              "type": "string"
            },
            "kind": {
              "const": "exact",
              "type": "string"
            }
          },
          "required": ["kind", "key"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One canonical structural prefix.",
          "properties": {
            "kind": {
              "const": "prefix",
              "type": "string"
            },
            "prefix": {
              "description": "Canonical prefix spelling.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["kind", "prefix"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One bounded canonical structural pattern.",
          "properties": {
            "kind": {
              "const": "pattern",
              "type": "string"
            },
            "pattern": {
              "description": "Canonical pattern spelling.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["kind", "pattern"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Every key in the configured scope-domain pair.",
          "properties": {
            "kind": {
              "const": "all-in-scope",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        }
      ]
    },
    "MessagesConfig": {
      "additionalProperties": false,
      "description": "Validated normalized `messages` section.",
      "properties": {
        "coverageBaseline": {
          "additionalProperties": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxProperties": 4096,
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "delivery": {
          "additionalProperties": false,
          "description": "Normalized delivery configuration admitted for executable message output.",
          "properties": {
            "targets": {
              "items": {
                "$ref": "#/definitions/MessageDeliveryTargetConfig"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": ["targets"],
          "type": "object"
        },
        "dynamicReferences": {
          "allOf": [
            {
              "$ref": "#/definitions/MessageDynamicReferenceMode"
            }
          ],
          "default": "compat"
        },
        "fallback": {
          "additionalProperties": {
            "items": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "maxProperties": 1024,
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "locales": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array"
        },
        "producers": {
          "$ref": "#/definitions/MessageProducersConfig"
        },
        "roots": {
          "items": {
            "$ref": "#/definitions/MessageRootConfig"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": ["locales"],
      "type": "object"
    },
    "ResourcesConfig": {
      "additionalProperties": false,
      "description": "Validated project resource configuration.",
      "properties": {
        "catalogs": {
          "description": "Project-relative resource catalog definitions. Omission preserves absent policy; an empty array disables catalogs.",
          "items": {
            "$ref": "#/definitions/CatalogConfig"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "$schema": {
      "description": "Editor-facing schema metadata. Ignored by the CLI at runtime.",
      "type": "string"
    },
    "fmt": {
      "$ref": "#/definitions/FormatterConfig",
      "description": "Formatter configuration."
    },
    "lint": {
      "$ref": "#/definitions/EmptyConfig",
      "description": "Linter configuration. Currently accepts only an empty object."
    },
    "messages": {
      "$ref": "#/definitions/MessagesConfig",
      "description": "Message-link policy and reference-producer configuration."
    },
    "resources": {
      "$ref": "#/definitions/ResourcesConfig",
      "description": "Resource catalog configuration."
    }
  },
  "title": "ProjectConfigFile",
  "type": "object"
}
