{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Body": {
      "additionalProperties": false,
      "properties": {
        "buildIdentity": {
          "$ref": "#/definitions/BuildIdentity"
        },
        "caseInventory": {
          "items": {
            "$ref": "#/definitions/InventoryEntry"
          },
          "type": "array"
        },
        "measurementProfile": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "measurementRun": {
          "$ref": "#/definitions/RecordIdentity"
        },
        "plannedRunnerClass": {
          "anyOf": [
            {
              "$ref": "#/definitions/Token"
            },
            {
              "type": "null"
            }
          ]
        },
        "runnerInstanceIdentity": {
          "$ref": "#/definitions/RecordIdentity"
        },
        "verificationSubject": {
          "$ref": "#/definitions/Subject"
        }
      },
      "required": [
        "measurementRun",
        "measurementProfile",
        "verificationSubject",
        "buildIdentity",
        "caseInventory",
        "runnerInstanceIdentity"
      ],
      "type": "object"
    },
    "BuildIdentity": {
      "additionalProperties": false,
      "description": "This is a content binding to the actual native Build Observation, not a\ncommon record ID, complete compiler attestation, or executable digest.",
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/NativeAlgorithm"
        },
        "checksum": {
          "$ref": "#/definitions/NativeObservationChecksum"
        },
        "domain": {
          "$ref": "#/definitions/NativeBuildDomain"
        },
        "framing": {
          "$ref": "#/definitions/NativeFraming"
        },
        "ownerSchema": {
          "$ref": "#/definitions/NativeBuildSchema"
        }
      },
      "required": ["ownerSchema", "algorithm", "framing", "domain", "checksum"],
      "type": "object"
    },
    "CaseIdentity": {
      "pattern": "^mc0_[0-9a-f]{64}$",
      "type": "string"
    },
    "CreationContext": {
      "additionalProperties": false,
      "properties": {
        "createdAtUnixNanoseconds": {
          "$ref": "#/definitions/UInt64"
        }
      },
      "required": ["createdAtUnixNanoseconds"],
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "creationContext": {
          "$ref": "#/definitions/CreationContext"
        },
        "governingSpecification": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "integrityDigest": {
          "$ref": "#/definitions/IntegrityDigest"
        },
        "producingTool": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "recordIdentity": {
          "$ref": "#/definitions/RecordIdentity"
        },
        "recordKind": {
          "$ref": "#/definitions/RunPlanKind"
        },
        "recordSchemaRevision": {
          "$ref": "#/definitions/RevisionZero"
        }
      },
      "required": [
        "recordKind",
        "recordSchemaRevision",
        "governingSpecification",
        "recordIdentity",
        "integrityDigest",
        "producingTool"
      ],
      "type": "object"
    },
    "Hex256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "InstanceDomain": {
      "enum": [
        "intlify-verification-record-v0",
        "intlify-measurement-run-v0",
        "intlify-config-owner-result-v1",
        "intlify-config-local-runner-instance-v0"
      ],
      "type": "string"
    },
    "IntegrityDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "InventoryEntry": {
      "additionalProperties": false,
      "properties": {
        "caseIdentity": {
          "$ref": "#/definitions/CaseIdentity"
        },
        "localRecordIdentity": {
          "$ref": "#/definitions/Token"
        },
        "requirement": {
          "$ref": "#/definitions/Required"
        }
      },
      "required": ["localRecordIdentity", "caseIdentity", "requirement"],
      "type": "object"
    },
    "NativeAlgorithm": {
      "enum": ["blake3"],
      "type": "string"
    },
    "NativeBuildDomain": {
      "enum": ["build-observation"],
      "type": "string"
    },
    "NativeBuildSchema": {
      "enum": ["intlify-config-build-observation/0"],
      "type": "string"
    },
    "NativeFraming": {
      "enum": ["intlify-config-minimum-observation/0"],
      "type": "string"
    },
    "NativeObservationChecksum": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "RecordIdentity": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "$ref": "#/definitions/InstanceDomain"
        },
        "value": {
          "$ref": "#/definitions/Hex256"
        }
      },
      "required": ["domain", "value"],
      "type": "object"
    },
    "Required": {
      "enum": ["required"],
      "type": "string"
    },
    "RevisionZero": {
      "enum": ["0"],
      "type": "string"
    },
    "RunPlanKind": {
      "enum": ["measurement-run-plan"],
      "type": "string"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
        "kind": {
          "$ref": "#/definitions/SubjectKind"
        }
      },
      "required": ["kind", "identity"],
      "type": "object"
    },
    "SubjectKind": {
      "enum": ["toolchain-component"],
      "type": "string"
    },
    "Token": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "type": "string"
    },
    "UInt64": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "VersionedIdentity": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
        "revision": {
          "$ref": "#/definitions/Token"
        }
      },
      "required": ["identity", "revision"],
      "type": "object"
    }
  },
  "properties": {
    "body": {
      "$ref": "#/definitions/Body"
    },
    "envelope": {
      "$ref": "#/definitions/Envelope"
    }
  },
  "required": ["envelope", "body"],
  "title": "RunPlanRecord",
  "type": "object"
}
