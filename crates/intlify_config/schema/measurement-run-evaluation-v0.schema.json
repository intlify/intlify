{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AnyIdentity": {
      "anyOf": [
        {
          "$ref": "#/definitions/RecordIdentity"
        },
        {
          "$ref": "#/definitions/OwnerRecordIdentity"
        }
      ],
      "description": "Either instance identity, as a reference target carries them equally.\n\nThe two are still separate types: a common record's own identity is never\nan owner instance, and reading one out of a reference does not make it one."
    },
    "BuildField": {
      "description": "The complete applicable Build fields one record reports on.",
      "enum": [
        "source-content",
        "implementation",
        "executable",
        "dependency-lock",
        "build-configuration",
        "physical-engine",
        "source-control-state"
      ],
      "type": "string"
    },
    "BuildIdentity": {
      "additionalProperties": false,
      "description": "A content binding to an owner's actual Build Observation.\n\nIt is not a common record identity, a compiler attestation, or an\nexecutable digest, so the framing that produced the checksum travels with it.",
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/OwnerLabel"
        },
        "checksum": {
          "$ref": "#/definitions/NativeChecksum"
        },
        "domain": {
          "$ref": "#/definitions/OwnerLabel"
        },
        "framing": {
          "$ref": "#/definitions/OwnerLabel"
        },
        "ownerSchema": {
          "$ref": "#/definitions/OwnerLabel"
        }
      },
      "required": ["ownerSchema", "algorithm", "framing", "domain", "checksum"],
      "type": "object"
    },
    "CaseEvaluation": {
      "additionalProperties": false,
      "description": "One planned case's evaluation.",
      "properties": {
        "caseIdentity": {
          "$ref": "#/definitions/CaseIdentity"
        },
        "localRecordIdentity": {
          "$ref": "#/definitions/Token"
        },
        "result": {
          "$ref": "#/definitions/CaseResult"
        }
      },
      "required": ["localRecordIdentity", "caseIdentity", "result"],
      "type": "object"
    },
    "CaseIdentity": {
      "pattern": "^mc0_[0-9a-f]{64}$",
      "type": "string"
    },
    "CaseResult": {
      "description": "What became of one planned case.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/definitions/Reference"
            },
            "kind": {
              "const": "measured",
              "type": "string"
            }
          },
          "required": ["kind", "evidence"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "applicabilityRule": {
              "$ref": "#/definitions/VersionedIdentity"
            },
            "kind": {
              "const": "not-applicable",
              "type": "string"
            }
          },
          "required": ["kind", "applicabilityRule"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnosticPartialObservations": {
              "items": {
                "$ref": "#/definitions/Reference"
              },
              "type": "array"
            },
            "kind": {
              "const": "unavailable",
              "type": "string"
            },
            "reasons": {
              "items": {
                "$ref": "#/definitions/Reason"
              },
              "minItems": 1,
              "type": "array"
            },
            "unavailableKind": {
              "$ref": "#/definitions/UnavailableKind"
            }
          },
          "required": ["kind", "unavailableKind", "reasons", "diagnosticPartialObservations"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "invalid",
              "type": "string"
            },
            "reasons": {
              "items": {
                "$ref": "#/definitions/Reason"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": ["kind", "reasons"],
          "type": "object"
        }
      ]
    },
    "Code": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/definitions/CommonCode"
            },
            "kind": {
              "const": "common",
              "type": "string"
            }
          },
          "required": ["kind", "code"],
          "type": "object"
        }
      ]
    },
    "CommonCode": {
      "description": "The registered common cause codes.",
      "enum": [
        "missing-evidence",
        "missing-required-case",
        "skipped-required-case",
        "unsupported-measurement",
        "failed-invocation",
        "projection-ineligible",
        "stale-evidence",
        "insufficient-samples",
        "schema-invalid",
        "integrity-digest-mismatch",
        "inconsistent-record",
        "duplicate-case",
        "unknown-case",
        "invalid-state-combination",
        "invalid-profile",
        "ambiguous-binding",
        "case-dimension-mismatch",
        "environment-mismatch",
        "method-mismatch",
        "interval-mismatch",
        "sampling-policy-mismatch",
        "semantic-observation-mismatch"
      ],
      "type": "string"
    },
    "CommonDomain": {
      "description": "The two instance domains 026 itself registers.",
      "enum": ["intlify-verification-record-v0", "intlify-measurement-run-v0"],
      "type": "string"
    },
    "CreationContext": {
      "additionalProperties": false,
      "properties": {
        "createdAtUnixNanoseconds": {
          "$ref": "#/definitions/UInt64"
        }
      },
      "required": ["createdAtUnixNanoseconds"],
      "type": "object"
    },
    "Detail": {
      "description": "The typed payload of a reason.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "$ref": "#/definitions/MissingObservation"
            },
            "kind": {
              "const": "missing-observation",
              "type": "string"
            }
          },
          "required": ["kind", "cause"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "missing-input",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unsupported-tuple",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "invalid-input",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "duplicate-input",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "binding-mismatch",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inventory-mismatch",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic": {
              "$ref": "#/definitions/Reference"
            },
            "kind": {
              "const": "invocation-failed",
              "type": "string"
            },
            "subtype": {
              "$ref": "#/definitions/InvocationFailure"
            }
          },
          "required": ["kind", "subtype", "diagnostic"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic": {
              "$ref": "#/definitions/Reference"
            },
            "kind": {
              "const": "invalid-owner-case",
              "type": "string"
            }
          },
          "required": ["kind", "diagnostic"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic": {
              "$ref": "#/definitions/Reference"
            },
            "kind": {
              "const": "semantic-mismatch",
              "type": "string"
            }
          },
          "required": ["kind", "diagnostic"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "available": {
              "$ref": "#/definitions/UInt64"
            },
            "kind": {
              "const": "sample-count",
              "type": "string"
            },
            "required": {
              "$ref": "#/definitions/UInt64"
            }
          },
          "required": ["kind", "required", "available"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "projection-mismatch",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "report-mismatch",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        }
      ]
    },
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "creationContext": {
          "$ref": "#/definitions/CreationContext"
        },
        "governingSpecification": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "integrityDigest": {
          "$ref": "#/definitions/IntegrityDigest"
        },
        "producingTool": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "recordIdentity": {
          "$ref": "#/definitions/RecordIdentity"
        },
        "recordKind": {
          "$ref": "#/definitions/EvaluationKind"
        },
        "recordSchemaRevision": {
          "$ref": "#/definitions/RevisionZero"
        }
      },
      "required": [
        "recordKind",
        "recordSchemaRevision",
        "governingSpecification",
        "recordIdentity",
        "integrityDigest",
        "producingTool"
      ],
      "type": "object"
    },
    "EnvironmentField": {
      "description": "Declaration order is the exact 026 environment registry order, not alphabetic.",
      "enum": [
        "os_family",
        "os_version",
        "kernel_build",
        "cpu_architecture",
        "target_triple",
        "runner_context",
        "execution_kind",
        "processor_class",
        "logical_cpu_count",
        "memory_capacity_class",
        "power_thermal_policy",
        "language_runtime",
        "browser",
        "virtual_machine",
        "device",
        "jit_gc_configuration",
        "toolchain",
        "build_configuration",
        "instrumentation",
        "allocator",
        "memory_observer",
        "clock_or_sampler",
        "concurrency",
        "container_emulator_simulator",
        "locale_service",
        "harness",
        "projection"
      ],
      "type": "string"
    },
    "EvaluationBody": {
      "additionalProperties": false,
      "description": "The complete Run Evaluation body.",
      "properties": {
        "binding": {
          "$ref": "#/definitions/RunBinding"
        },
        "caseInventory": {
          "items": {
            "$ref": "#/definitions/InventoryEntry"
          },
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/definitions/CaseEvaluation"
          },
          "type": "array"
        },
        "outcome": {
          "$ref": "#/definitions/Outcome"
        },
        "ownerResultInput": {
          "$ref": "#/definitions/InputResolution"
        },
        "reasons": {
          "items": {
            "$ref": "#/definitions/Reason"
          },
          "type": "array"
        }
      },
      "required": ["binding", "ownerResultInput", "caseInventory", "cases", "outcome", "reasons"],
      "type": "object"
    },
    "EvaluationKind": {
      "description": "The Measurement Run Evaluation record kind.",
      "enum": ["measurement-run-evaluation"],
      "type": "string"
    },
    "ExpectedOwner": {
      "additionalProperties": false,
      "description": "The owner result a Run Evaluation expected to resolve.",
      "properties": {
        "benchmarkProfile": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "recordIdentity": {
          "$ref": "#/definitions/OwnerRecordIdentity"
        },
        "resultSchema": {
          "$ref": "#/definitions/OwnerLabel"
        }
      },
      "required": ["recordIdentity", "resultSchema", "benchmarkProfile"],
      "type": "object"
    },
    "Hex256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "InputResolution": {
      "additionalProperties": false,
      "description": "The owner result this evaluation expected, and what it got.",
      "properties": {
        "expected": {
          "$ref": "#/definitions/ExpectedOwner"
        },
        "result": {
          "$ref": "#/definitions/InputState"
        }
      },
      "required": ["expected", "result"],
      "type": "object"
    },
    "InputState": {
      "description": "Whether the owner result resolved, and if not, exactly why.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resolved",
              "type": "string"
            },
            "reference": {
              "$ref": "#/definitions/Reference"
            }
          },
          "required": ["kind", "reference"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            },
            "reasons": {
              "items": {
                "$ref": "#/definitions/Reason"
              },
              "minItems": 1,
              "type": "array"
            },
            "sourceEvaluations": {
              "items": {
                "$ref": "#/definitions/Reference"
              },
              "type": "array"
            }
          },
          "required": ["kind", "sourceEvaluations", "reasons"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "invalid",
              "type": "string"
            },
            "reasons": {
              "items": {
                "$ref": "#/definitions/Reason"
              },
              "minItems": 1,
              "type": "array"
            },
            "submittedInput": {
              "$ref": "#/definitions/Reference"
            }
          },
          "required": ["kind", "reasons"],
          "type": "object"
        }
      ]
    },
    "IntegrityDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "InventoryEntry": {
      "additionalProperties": false,
      "description": "One planned case, named locally inside the Plan that declares it.",
      "properties": {
        "caseIdentity": {
          "$ref": "#/definitions/CaseIdentity"
        },
        "localRecordIdentity": {
          "$ref": "#/definitions/Token"
        },
        "requirement": {
          "$ref": "#/definitions/Required"
        }
      },
      "required": ["localRecordIdentity", "caseIdentity", "requirement"],
      "type": "object"
    },
    "InvocationFailure": {
      "description": "How exactly a measured invocation failed.",
      "enum": [
        "measurement-overflow",
        "counter-overflow",
        "repetition-overflow",
        "duration-conversion-overflow",
        "clock-failure",
        "invocation-panicked",
        "prerequisite-unavailable",
        "collector-allocation",
        "output-failure",
        "observation-panicked",
        "work-observation-failure"
      ],
      "type": "string"
    },
    "MissingObservation": {
      "description": "Why an observation is absent. Absence is never reported as a value.",
      "enum": [
        "not-collected",
        "native-acquisition-unavailable",
        "effective-build-not-attested",
        "executable-not-attested",
        "kernel-release-is-not-build-identity",
        "parallelism-hint-is-not-logical-cpu-count",
        "finite-provider-has-no-locale-service-profile",
        "source-control-state-not-attested"
      ],
      "type": "string"
    },
    "NativeChecksum": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "NestedReference": {
      "additionalProperties": false,
      "description": "One local record inside a named parent record.",
      "properties": {
        "localRecordIdentity": {
          "$ref": "#/definitions/Token"
        },
        "parentRecordIdentity": {
          "$ref": "#/definitions/AnyIdentity"
        }
      },
      "required": ["parentRecordIdentity", "localRecordIdentity"],
      "type": "object"
    },
    "Outcome": {
      "description": "Whether a run produced a complete result for its planned inventory.",
      "enum": ["complete", "incomplete", "invalid"],
      "type": "string"
    },
    "OwnerDomain": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "type": "string"
    },
    "OwnerLabel": {
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "OwnerRecordIdentity": {
      "additionalProperties": false,
      "description": "One fresh instance identity in a domain an owner registers.\n\nThe domain is the owner's, so this crate checks its grammar and its\nseparation from the common domains, never its meaning.",
      "properties": {
        "domain": {
          "$ref": "#/definitions/OwnerDomain"
        },
        "value": {
          "$ref": "#/definitions/Hex256"
        }
      },
      "required": ["domain", "value"],
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "One complete reason: code, stage, what it affects, and its typed payload.",
      "properties": {
        "affected": {
          "$ref": "#/definitions/Selector"
        },
        "code": {
          "$ref": "#/definitions/Code"
        },
        "detail": {
          "$ref": "#/definitions/Detail"
        },
        "related": {
          "items": {
            "$ref": "#/definitions/Reference"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/definitions/Stage"
        }
      },
      "required": ["code", "stage", "affected", "related", "detail"],
      "type": "object"
    },
    "RecordIdentity": {
      "additionalProperties": false,
      "description": "One fresh instance identity in a domain this crate registers.",
      "properties": {
        "domain": {
          "$ref": "#/definitions/CommonDomain"
        },
        "value": {
          "$ref": "#/definitions/Hex256"
        }
      },
      "required": ["domain", "value"],
      "type": "object"
    },
    "Reference": {
      "description": "One reference to a complete record or to a local record inside one.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "top-level",
              "type": "string"
            },
            "recordIdentity": {
              "$ref": "#/definitions/AnyIdentity"
            }
          },
          "required": ["kind", "recordIdentity"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "nested-record",
              "type": "string"
            },
            "reference": {
              "$ref": "#/definitions/NestedReference"
            }
          },
          "required": ["kind", "reference"],
          "type": "object"
        }
      ]
    },
    "Required": {
      "description": "A case an inventory cannot omit.",
      "enum": ["required"],
      "type": "string"
    },
    "RevisionZero": {
      "enum": ["0"],
      "type": "string"
    },
    "RunBinding": {
      "additionalProperties": false,
      "description": "The exact run this record belongs to.",
      "properties": {
        "buildIdentity": {
          "$ref": "#/definitions/BuildIdentity"
        },
        "measurementProfile": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "measurementRun": {
          "$ref": "#/definitions/RecordIdentity"
        },
        "measurementRunPlan": {
          "$ref": "#/definitions/RecordIdentity"
        },
        "verificationSubject": {
          "$ref": "#/definitions/Subject"
        }
      },
      "required": [
        "measurementRun",
        "measurementRunPlan",
        "measurementProfile",
        "verificationSubject",
        "buildIdentity"
      ],
      "type": "object"
    },
    "Selector": {
      "description": "What exactly a reason is about.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "record",
              "type": "string"
            },
            "reference": {
              "$ref": "#/definitions/Reference"
            }
          },
          "required": ["kind", "reference"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "caseIdentity": {
              "$ref": "#/definitions/CaseIdentity"
            },
            "kind": {
              "const": "planned-case",
              "type": "string"
            },
            "runPlan": {
              "$ref": "#/definitions/RecordIdentity"
            }
          },
          "required": ["kind", "runPlan", "caseIdentity"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/definitions/EnvironmentField"
            },
            "kind": {
              "const": "environment-field",
              "type": "string"
            },
            "recordIdentity": {
              "$ref": "#/definitions/RecordIdentity"
            }
          },
          "required": ["kind", "recordIdentity", "field"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/definitions/BuildField"
            },
            "kind": {
              "const": "build-field",
              "type": "string"
            },
            "recordIdentity": {
              "$ref": "#/definitions/RecordIdentity"
            }
          },
          "required": ["kind", "recordIdentity", "field"],
          "type": "object"
        }
      ]
    },
    "Stage": {
      "description": "The stage of the pipeline a reason was raised in.",
      "enum": [
        "input-admission",
        "plan",
        "binding",
        "inventory",
        "case-result",
        "evidence",
        "environment",
        "reporting"
      ],
      "type": "string"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "What exactly was measured.",
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
        "kind": {
          "$ref": "#/definitions/SubjectKind"
        }
      },
      "required": ["kind", "identity"],
      "type": "object"
    },
    "SubjectKind": {
      "description": "A subject that is one component of a toolchain.",
      "enum": ["toolchain-component"],
      "type": "string"
    },
    "Token": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "type": "string"
    },
    "UInt64": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "UnavailableKind": {
      "description": "Why a planned case produced no measurement.\n\nThe kinds are separate because they call for different responses, and none\nof them is a measured result.",
      "enum": ["missing", "skipped", "unsupported", "failed", "projection-ineligible", "stale"],
      "type": "string"
    },
    "VersionedIdentity": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
