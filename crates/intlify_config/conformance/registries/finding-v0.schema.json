{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FindingRegistry",
  "description": "The registry's body: the disclosure policies, one for each evidence kind,\nand the rows (D15:2233).",
  "type": "object",
  "properties": {
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DisclosurePolicy"
      },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FindingRow"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "policies",
    "rows"
  ],
  "definitions": {
    "DisclosurePolicy": {
      "description": "One evidence kind's disclosure policy.",
      "type": "object",
      "properties": {
        "evidenceKind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "required": {
          "description": "The members every Evidence of the kind has.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Member"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "components": {
          "description": "Each component the kind's view can retain, in view order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentPolicy"
          },
          "minItems": 1
        },
        "paths": {
          "description": "For a resolver-input kind, the component path shapes some retained\nEvidence can carry, in Evidence order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathShape"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "evidenceKind",
        "required",
        "components"
      ]
    },
    "EvidenceKind": {
      "description": "What an origin-bearing Evidence item describes.",
      "type": "string",
      "enum": [
        "entry-source",
        "configuration-value",
        "profile-selector",
        "specification-input",
        "artifact-input",
        "verification-input",
        "implementation-capability"
      ]
    },
    "Member": {
      "description": "A member of an Evidence view (D15:2481).",
      "type": "string",
      "enum": [
        "source",
        "locator",
        "path",
        "value",
        "span",
        "selector",
        "component"
      ]
    },
    "ComponentPolicy": {
      "description": "How a policy discloses one component.",
      "type": "object",
      "properties": {
        "component": {
          "$ref": "#/definitions/Component"
        },
        "disclosure": {
          "$ref": "#/definitions/Disclosure"
        },
        "nonSecretWhen": {
          "description": "For a literal component whose content is not fixed, the\nclassifications under which that content counts as non-secret.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/NonSecretClass"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tokenProjection": {
          "description": "For a redacted component, the projection whose token replaces it.",
          "allOf": [
            {
              "$ref": "#/definitions/TokenKind"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "component",
        "disclosure"
      ]
    },
    "Component": {
      "description": "A component an Evidence view can retain: a leaf variant of one of its\nmembers, in the order of the view's members and of each member's\nvariants (D15:2492).",
      "type": "string",
      "enum": [
        "source.safe-opaque",
        "source.redacted",
        "locator.relative-path",
        "locator.safe-label",
        "locator.safe-uri",
        "path.safe-member",
        "path.array-index",
        "path.redacted-member",
        "value.exact-json-pointer",
        "value.redacted-logical-path.safe-member",
        "value.redacted-logical-path.array-index",
        "value.redacted-logical-path.redacted-member",
        "span",
        "selector.absent",
        "selector.safe-profile-id",
        "selector.redacted-value",
        "component.fixed-role",
        "component.safe-key",
        "component.redacted-key"
      ]
    },
    "Disclosure": {
      "description": "One of the two disclosure policies of a component (D15:720).",
      "type": "string",
      "enum": [
        "non-secret-literal",
        "redacted-structure"
      ]
    },
    "NonSecretClass": {
      "description": "Why a literal component's content counts as non-secret.",
      "oneOf": [
        {
          "description": "The adapter or frontend that owns the identity's domain marks it\nnon-secret (Decision 015-185).",
          "type": "string",
          "const": "owner-marked-identity"
        },
        {
          "description": "The supplying adapter classifies the canonical locator non-secret\n(D15:766).",
          "type": "string",
          "const": "adapter-classified-locator"
        },
        {
          "description": "The member name is defined by the configuration schema (D15:776).",
          "type": "string",
          "const": "schema-defined-name"
        },
        {
          "description": "A `profiles`, `targetProfiles`, or `deploymentGroups` key that matches\nthe identifier syntax within the capability's byte bound (D15:776).",
          "type": "string",
          "const": "identifier-key"
        },
        {
          "description": "A `localeNegotiation.aliases` or `messageFallback` key for which the\nadmitted canonicalization data returns a canonical identifier\n(D15:776).",
          "type": "string",
          "const": "canonical-locale-key"
        },
        {
          "description": "A selector that exactly matches a declared Profile ID (D15:807).",
          "type": "string",
          "const": "declared-profile-id"
        },
        {
          "description": "A vocabulary member's canonical vocabulary identity (D15:824).",
          "type": "string",
          "const": "vocabulary-identity"
        },
        {
          "description": "An admitted envelope's canonical exact-reference identity (D15:824).",
          "type": "string",
          "const": "admitted-exact-reference"
        }
      ]
    },
    "TokenKind": {
      "description": "The evidence kind a token's record names: the projection of the component\nthe token replaces, or `profile-selector` for a selector's value. The\nFinding Registry's disclosure policies name it by its ID.",
      "type": "string",
      "enum": [
        "source-identity",
        "logical-input-path-member",
        "value-path-member",
        "resolver-input-component-key",
        "profile-selector"
      ]
    },
    "PathShape": {
      "description": "A component path shape: the origin, the fixed roles, and the key that\nends it, if one does.",
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/definitions/SafeOriginKind"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RoleShape"
          }
        },
        "key": {
          "$ref": "#/definitions/KeyKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "roles"
      ]
    },
    "SafeOriginKind": {
      "description": "The fixed input boundary that supplied an origin-bearing Evidence item,\ndeclared in rank order.",
      "type": "string",
      "enum": [
        "configuration-file",
        "configuration-programmatic",
        "profile-selector-cli",
        "profile-selector-programmatic",
        "profile-resolution-specification-input",
        "intent-surface-class-vocabulary",
        "locale-canonicalization-data",
        "profile-resolution-artifact-collection",
        "resource-limit-policy-verification",
        "implementation-capability"
      ]
    },
    "RoleShape": {
      "description": "A fixed role of a component path, with its rank within its parent path\n(D15:823).",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "rank"
      ]
    },
    "KeyKind": {
      "description": "The key that ends a component path shape.",
      "type": "string",
      "enum": [
        "safe-key",
        "redacted-key"
      ]
    },
    "FindingRow": {
      "description": "One row: one Finding code, the checks that may report it, and how it\nreports.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/FindingCode"
        },
        "allowedCheckIds": {
          "description": "The checks that may report the code, in the Check Registry's order.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "blocking": {
          "type": "boolean"
        },
        "allowedSubjectKinds": {
          "description": "The subject kinds of those checks, in the order they first appear.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubjectKind"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedReasons": {
          "description": "The code's stable reasons, in the order 015 lists them; none for a\ncode without stable reasons.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FindingReason"
          },
          "uniqueItems": true
        },
        "occurrencePrimaryEvidenceKindByCheck": {
          "description": "For each check, in `allowedCheckIds` order, the primary evidence kind\nof its occurrences.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PrimaryEntry"
          },
          "minItems": 1
        },
        "occurrenceRelatedEvidenceKindsByCheck": {
          "description": "For each check, in `allowedCheckIds` order, the related evidence\nkinds of its occurrences.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelatedEntry"
          },
          "minItems": 1
        },
        "evidenceDisclosurePolicies": {
          "description": "The disclosure policy of each evidence kind the two columns before\nname, with a resolver-input kind's shapes.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PolicyEntry"
          }
        },
        "allowedSafeOriginKindsByEvidenceKind": {
          "description": "The Safe Origin Kinds the row allows each of those kinds.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OriginEntry"
          }
        },
        "suggestionKind": {
          "$ref": "#/definitions/SuggestionKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "allowedCheckIds",
        "severity",
        "blocking",
        "allowedSubjectKinds",
        "allowedReasons",
        "occurrencePrimaryEvidenceKindByCheck",
        "occurrenceRelatedEvidenceKindsByCheck",
        "evidenceDisclosurePolicies",
        "allowedSafeOriginKindsByEvidenceKind",
        "suggestionKind"
      ]
    },
    "FindingCode": {
      "type": "string",
      "enum": [
        "project-profile-json-invalid",
        "project-profile-json-member-duplicate",
        "project-profile-input-not-json-compatible",
        "project-profile-schema-version-unsupported",
        "project-profile-required-field-missing",
        "project-profile-field-type-invalid",
        "project-profile-field-value-invalid",
        "project-profile-unknown-field",
        "project-profile-selector-required",
        "project-profile-selector-invalid",
        "project-profile-selector-unknown",
        "project-profile-specification-input-incomplete",
        "project-profile-specification-not-admitted",
        "project-profile-locale-specification-not-admitted",
        "project-profile-locale-data-not-admitted",
        "project-profile-negotiation-specification-not-admitted",
        "project-profile-message-fallback-specification-not-admitted",
        "project-profile-coverage-specification-not-admitted",
        "project-profile-delivery-specification-not-admitted",
        "project-profile-intent-surface-class-vocabulary-not-admitted",
        "project-profile-locale-invalid",
        "project-profile-locale-non-canonical",
        "project-profile-locale-duplicate",
        "project-profile-default-requested-locale-not-in-project",
        "project-profile-target-locales-not-subset",
        "project-profile-target-default-locale-not-supported",
        "project-profile-target-locale-direction-missing",
        "project-profile-negotiation-alias-duplicate",
        "project-profile-negotiation-alias-destination-not-requested",
        "project-profile-message-fallback-source-not-requested",
        "project-profile-message-fallback-sequence-invalid",
        "project-profile-coverage-rule-invalid",
        "project-profile-coverage-rule-duplicate",
        "project-profile-coverage-rule-conflict",
        "project-profile-artifact-reference-not-admitted",
        "project-profile-artifact-collection-not-admitted",
        "project-profile-group-member-unknown",
        "project-profile-group-member-duplicate",
        "project-profile-target-unassigned",
        "project-profile-target-assigned-to-multiple-groups",
        "project-profile-hydration-relation-invalid",
        "project-profile-hydration-locale-policy-incompatible",
        "project-profile-hydration-capability-incompatible",
        "project-profile-resource-policy-not-admitted",
        "project-profile-resource-policy-capability-incompatible",
        "project-profile-bootstrap-limit-exceeded",
        "project-profile-resource-limit-exceeded",
        "project-profile-reporting-limit-exceeded"
      ]
    },
    "Severity": {
      "description": "A Finding's severity: `error` for every blocking code, and `warning` for\nthe one code that blocks nothing.",
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "SubjectKind": {
      "type": "string",
      "enum": [
        "project-profile-slot",
        "entry-dependencies",
        "complete-input",
        "materialized-dependencies",
        "configuration-schema-selection",
        "capability-structural-analysis",
        "root-field",
        "profile-key",
        "profile-field",
        "target-profile-key",
        "target-field",
        "deployment-group-key",
        "group-field",
        "profile-specification-dependency",
        "capability-profiles",
        "capability-profile-id",
        "profile-selector",
        "capability-artifacts",
        "capability-policy-artifacts",
        "capability-target-profile-artifacts",
        "capability-references",
        "capability-artifact",
        "capability-artifact-bytes",
        "capability-policy-reference",
        "capability-target-profile-reference",
        "capability-reference-bytes",
        "resource-limits",
        "root-nodes",
        "root-depth",
        "root-collection-entries",
        "root-string-bytes",
        "root-longest-string",
        "profiles",
        "profile-id",
        "selector",
        "structural-analysis",
        "artifacts",
        "policy-artifacts",
        "target-profile-artifacts",
        "references",
        "artifact",
        "artifact-bytes",
        "policy-reference",
        "target-profile-reference",
        "reference-bytes",
        "locale-canonicalization-slot",
        "locale-negotiation-slot",
        "message-locale-fallback-slot",
        "coverage-slot",
        "intent-surface-class-vocabulary-slot",
        "delivery-graph-slot",
        "delivery-placement-slot",
        "vocabulary",
        "canonicalization-data",
        "locale-canonicalization-dependency",
        "declaration-field",
        "project-identity-dependency",
        "locale-occurrences",
        "requested-locale",
        "requested-locales",
        "default-source-locale",
        "default-requested-locale",
        "negotiation-alias-key",
        "negotiation-alias-value",
        "message-fallback-key",
        "target-profiles",
        "target-id",
        "target-requested-locale",
        "target-default-requested-locale",
        "project-locales-dependency",
        "negotiation-aliases",
        "negotiation-key",
        "negotiation-destination",
        "fallback-sources",
        "fallback-source",
        "fallback-sequence",
        "fallback-candidate",
        "fallback-literal",
        "fallback-intent-source",
        "coverage-rules",
        "coverage-locale-selectors",
        "coverage-surface-selectors",
        "coverage-locale",
        "coverage-surface-class",
        "coverage-rule",
        "coverage-domain",
        "coverage-cells",
        "coverage-comparisons",
        "coverage-cell",
        "coverage-table",
        "locale-negotiation-dependency",
        "message-fallback-dependency",
        "coverage-dependency",
        "collection-member",
        "collection-group",
        "resolved-policy-reference",
        "resolved-target-profile-reference",
        "required-policies-dependency",
        "optional-policies-dependency",
        "delivery-placement",
        "delivery-dependency",
        "target",
        "targets-dependency",
        "groups",
        "memberships",
        "group",
        "group-members",
        "group-member",
        "assignment",
        "relations",
        "relation-endpoint",
        "relation",
        "roles",
        "deployment-groups-dependency",
        "diagnostic-domain"
      ]
    },
    "FindingReason": {
      "type": "string",
      "enum": [
        "unsupported-type",
        "non-finite-number",
        "non-portable-number",
        "invalid-unicode",
        "non-string-key",
        "dynamic-container",
        "dynamic-property",
        "sparse-array",
        "cycle",
        "missing-required-slot",
        "unsupported",
        "incompatible",
        "body-integrity-invalid",
        "member-invalid",
        "member-duplicate",
        "non-canonical-order",
        "identity-mismatch",
        "revision-mismatch",
        "digest-mismatch",
        "explicit-override",
        "inherited-project-default",
        "same-destination",
        "conflicting-destination",
        "literal-self-reference",
        "literal-duplicate",
        "intent-source-duplicate",
        "locale-not-requested",
        "surface-class-unknown",
        "surface-class-duplicate",
        "not-found",
        "kind-mismatch",
        "specification-revision-mismatch",
        "specification-revision-unsupported",
        "role-kind-mismatch",
        "envelope-invalid",
        "kind-unsupported",
        "duplicate-envelope",
        "conflicting-content",
        "equal-endpoint",
        "unknown-endpoint",
        "cross-group",
        "duplicate-relation",
        "server-capability-missing",
        "client-capability-missing",
        "dual-role",
        "requested-locales",
        "effective-default",
        "body-schema-invalid",
        "project-profile-resolution-missing",
        "project-profile-resolution-invalid",
        "entry",
        "shared"
      ]
    },
    "PrimaryEntry": {
      "description": "One check's primary evidence kind.",
      "type": "object",
      "properties": {
        "checkId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "kind": {
          "$ref": "#/definitions/PrimaryKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "checkId",
        "kind"
      ]
    },
    "PrimaryKind": {
      "description": "A check's primary evidence kind, or `none` for the terminal reporting\nFinding (D15:2249).",
      "type": "string",
      "enum": [
        "entry-source",
        "configuration-value",
        "profile-selector",
        "specification-input",
        "artifact-input",
        "verification-input",
        "implementation-capability",
        "none"
      ]
    },
    "RelatedEntry": {
      "description": "One check's related evidence kinds, in the order of the admitted\nevidence kinds.",
      "type": "object",
      "properties": {
        "checkId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceKind"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "checkId",
        "kinds"
      ]
    },
    "PolicyEntry": {
      "description": "The disclosure policy of one evidence kind the row names, with, for a\nresolver-input kind, the component path shapes its occurrences can\ncarry, in Evidence order.",
      "type": "object",
      "properties": {
        "evidenceKind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathShape"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "evidenceKind"
      ]
    },
    "OriginEntry": {
      "description": "The Safe Origin Kinds the row allows one evidence kind, in rank order.",
      "type": "object",
      "properties": {
        "evidenceKind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SafeOriginKind"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "evidenceKind",
        "origins"
      ]
    },
    "SuggestionKind": {
      "description": "The shape of a Finding's safe suggestion: none, or the exact canonical\nreplacement of a locale spelling.",
      "type": "string",
      "enum": [
        "none",
        "canonical-locale-replacement"
      ]
    }
  }
}
