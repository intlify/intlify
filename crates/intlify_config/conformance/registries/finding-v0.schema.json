{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FindingRegistry",
  "description": "The registry's body.",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FindingRow"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "rows"
  ],
  "definitions": {
    "FindingRow": {
      "description": "One row: one Finding code, the checks that may report it, and how it\nreports.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/FindingCode"
        },
        "allowedCheckIds": {
          "description": "The checks that may report the code, in the Check Registry's order.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "blocking": {
          "type": "boolean"
        },
        "allowedSubjectKinds": {
          "description": "The subject kinds of those checks, in the order they first appear.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubjectKind"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedReasons": {
          "description": "The code's stable reasons, in the order 015 lists them; none for a\ncode without stable reasons.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FindingReason"
          },
          "uniqueItems": true
        },
        "suggestionKind": {
          "$ref": "#/definitions/SuggestionKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "allowedCheckIds",
        "severity",
        "blocking",
        "allowedSubjectKinds",
        "allowedReasons",
        "suggestionKind"
      ]
    },
    "FindingCode": {
      "type": "string",
      "enum": [
        "project-profile-json-invalid",
        "project-profile-json-member-duplicate",
        "project-profile-input-not-json-compatible",
        "project-profile-schema-version-unsupported",
        "project-profile-required-field-missing",
        "project-profile-field-type-invalid",
        "project-profile-field-value-invalid",
        "project-profile-unknown-field",
        "project-profile-selector-required",
        "project-profile-selector-invalid",
        "project-profile-selector-unknown",
        "project-profile-specification-input-incomplete",
        "project-profile-specification-not-admitted",
        "project-profile-locale-specification-not-admitted",
        "project-profile-locale-data-not-admitted",
        "project-profile-negotiation-specification-not-admitted",
        "project-profile-message-fallback-specification-not-admitted",
        "project-profile-coverage-specification-not-admitted",
        "project-profile-delivery-specification-not-admitted",
        "project-profile-intent-surface-class-vocabulary-not-admitted",
        "project-profile-locale-invalid",
        "project-profile-locale-non-canonical",
        "project-profile-locale-duplicate",
        "project-profile-default-requested-locale-not-in-project",
        "project-profile-target-locales-not-subset",
        "project-profile-target-default-locale-not-supported",
        "project-profile-target-locale-direction-missing",
        "project-profile-negotiation-alias-duplicate",
        "project-profile-negotiation-alias-destination-not-requested",
        "project-profile-message-fallback-source-not-requested",
        "project-profile-message-fallback-sequence-invalid",
        "project-profile-coverage-rule-invalid",
        "project-profile-coverage-rule-duplicate",
        "project-profile-coverage-rule-conflict",
        "project-profile-artifact-reference-not-admitted",
        "project-profile-artifact-collection-not-admitted",
        "project-profile-group-member-unknown",
        "project-profile-group-member-duplicate",
        "project-profile-target-unassigned",
        "project-profile-target-assigned-to-multiple-groups",
        "project-profile-hydration-relation-invalid",
        "project-profile-hydration-locale-policy-incompatible",
        "project-profile-hydration-capability-incompatible",
        "project-profile-resource-policy-not-admitted",
        "project-profile-resource-policy-capability-incompatible",
        "project-profile-bootstrap-limit-exceeded",
        "project-profile-resource-limit-exceeded",
        "project-profile-reporting-limit-exceeded"
      ]
    },
    "Severity": {
      "description": "A Finding's severity: `error` for every blocking code, and `warning` for\nthe one code that blocks nothing.",
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "SubjectKind": {
      "type": "string",
      "enum": [
        "project-profile-slot",
        "entry-dependencies",
        "complete-input",
        "materialized-dependencies",
        "configuration-schema-selection",
        "capability-structural-analysis",
        "root-field",
        "profile-key",
        "profile-field",
        "target-profile-key",
        "target-field",
        "deployment-group-key",
        "group-field",
        "profile-specification-dependency",
        "capability-profiles",
        "capability-profile-id",
        "profile-selector",
        "capability-artifacts",
        "capability-policy-artifacts",
        "capability-target-profile-artifacts",
        "capability-references",
        "capability-artifact",
        "capability-artifact-bytes",
        "capability-policy-reference",
        "capability-target-profile-reference",
        "capability-reference-bytes",
        "resource-limits",
        "root-nodes",
        "root-depth",
        "root-collection-entries",
        "root-string-bytes",
        "root-longest-string",
        "profiles",
        "profile-id",
        "selector",
        "structural-analysis",
        "artifacts",
        "policy-artifacts",
        "target-profile-artifacts",
        "references",
        "artifact",
        "artifact-bytes",
        "policy-reference",
        "target-profile-reference",
        "reference-bytes",
        "locale-canonicalization-slot",
        "locale-negotiation-slot",
        "message-locale-fallback-slot",
        "coverage-slot",
        "intent-surface-class-vocabulary-slot",
        "delivery-graph-slot",
        "delivery-placement-slot",
        "vocabulary",
        "canonicalization-data",
        "locale-canonicalization-dependency",
        "declaration-field",
        "project-identity-dependency",
        "locale-occurrences",
        "requested-locale",
        "requested-locales",
        "default-source-locale",
        "default-requested-locale",
        "negotiation-alias-key",
        "negotiation-alias-value",
        "message-fallback-key",
        "target-profiles",
        "target-id",
        "target-requested-locale",
        "target-default-requested-locale",
        "project-locales-dependency",
        "negotiation-aliases",
        "negotiation-key",
        "negotiation-destination",
        "fallback-sources",
        "fallback-source",
        "fallback-sequence",
        "fallback-candidate",
        "fallback-literal",
        "fallback-intent-source",
        "coverage-rules",
        "coverage-locale-selectors",
        "coverage-surface-selectors",
        "coverage-locale",
        "coverage-surface-class",
        "coverage-rule",
        "coverage-domain",
        "coverage-cells",
        "coverage-comparisons",
        "coverage-cell",
        "coverage-table",
        "locale-negotiation-dependency",
        "message-fallback-dependency",
        "coverage-dependency",
        "collection-member",
        "collection-group",
        "resolved-policy-reference",
        "resolved-target-profile-reference",
        "required-policies-dependency",
        "optional-policies-dependency",
        "delivery-placement",
        "delivery-dependency",
        "target",
        "targets-dependency",
        "groups",
        "memberships",
        "group",
        "group-members",
        "group-member",
        "assignment",
        "relations",
        "relation-endpoint",
        "relation",
        "roles",
        "deployment-groups-dependency",
        "diagnostic-domain"
      ]
    },
    "FindingReason": {
      "type": "string",
      "enum": [
        "unsupported-type",
        "non-finite-number",
        "non-portable-number",
        "invalid-unicode",
        "non-string-key",
        "dynamic-container",
        "dynamic-property",
        "sparse-array",
        "cycle",
        "missing-required-slot",
        "unsupported",
        "incompatible",
        "body-integrity-invalid",
        "member-invalid",
        "member-duplicate",
        "non-canonical-order",
        "identity-mismatch",
        "revision-mismatch",
        "digest-mismatch",
        "explicit-override",
        "inherited-project-default",
        "same-destination",
        "conflicting-destination",
        "literal-self-reference",
        "literal-duplicate",
        "intent-source-duplicate",
        "locale-not-requested",
        "surface-class-unknown",
        "surface-class-duplicate",
        "not-found",
        "kind-mismatch",
        "specification-revision-mismatch",
        "specification-revision-unsupported",
        "role-kind-mismatch",
        "envelope-invalid",
        "kind-unsupported",
        "duplicate-envelope",
        "conflicting-content",
        "equal-endpoint",
        "unknown-endpoint",
        "cross-group",
        "duplicate-relation",
        "server-capability-missing",
        "client-capability-missing",
        "dual-role",
        "requested-locales",
        "effective-default",
        "body-schema-invalid",
        "project-profile-resolution-missing",
        "project-profile-resolution-invalid",
        "entry",
        "shared"
      ]
    },
    "SuggestionKind": {
      "description": "The shape of a Finding's safe suggestion: none, or the exact canonical\nreplacement of a locale spelling.",
      "type": "string",
      "enum": [
        "none",
        "canonical-locale-replacement"
      ]
    }
  }
}
