{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intlify Message Reference Artifact v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "producer", "identity", "deliveryUnit", "references"],
  "properties": {
    "kind": {
      "const": "message-reference"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "identity": {
      "$ref": "#/$defs/referenceArtifactIdentity"
    },
    "deliveryUnit": {
      "$ref": "#/$defs/deliveryUnit"
    },
    "references": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {
          "const": 0
        },
        "minor": {
          "const": 1
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        }
      }
    },
    "projectNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "project"
        }
      }
    },
    "logicalSegment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000/]+$",
      "not": {
        "enum": [".", ".."]
      },
      "description": "Decoded UTF-8 byte ceilings are enforced by intlify_contract."
    },
    "referenceArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "segments"],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/projectNamespace"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/logicalSegment"
          }
        }
      }
    },
    "deliveryUnit": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/logicalSegment"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name"],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/projectNamespace"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The 255 decoded UTF-8 byte ceiling is enforced by intlify_contract."
        }
      }
    },
    "domain": {
      "enum": ["json-pointer", "yaml-typed-path", "xliff-1.2", "xliff-2"]
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key"],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "key": {
              "type": "string",
              "$comment": "An empty string is valid when the selected catalog-key domain defines a root key; the artifact codec enforces domain grammar."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "prefix"],
          "properties": {
            "kind": {
              "const": "prefix"
            },
            "prefix": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "pattern"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "all-in-scope"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "unbounded-dynamic"
            }
          }
        }
      ],
      "description": "Domain-specific key, prefix, pattern, token, and byte rules are enforced by intlify_contract."
    },
    "portablePath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/logicalSegment"
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "path"],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/projectNamespace"
        },
        "path": {
          "$ref": "#/$defs/portablePath"
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "description": "The start <= end invariant is enforced by intlify_contract."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "span"],
      "properties": {
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "domain", "selector"],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Decoded byte and control-scalar rules are enforced by intlify_contract."
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      }
    }
  }
}
