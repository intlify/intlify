{
  "fixtureId": "intlify-authoring-phase1-message-analysis",
  "fixtureRevision": "0",
  "note": "Expected results are written independently from the implementation. A case is never updated by copying what the analyzer produced; the MF2 source, segments, and parameter sets below are derived from design 016 and the MF2 grammar by hand.",
  "cases": [
    {
      "id": "literal-plain-text",
      "family": "extraction",
      "input": { "kind": "literal", "text": "Pay now" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{Pay now}}",
        "parameters": [],
        "segments": [
          { "extracted": ["0", "2"], "source": ["0", "0"] },
          { "extracted": ["2", "9"], "source": ["0", "7"] },
          { "extracted": ["9", "11"], "source": ["7", "7"] }
        ]
      }
    },
    {
      "id": "literal-empty-text",
      "family": "extraction",
      "input": { "kind": "literal", "text": "" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{}}",
        "parameters": [],
        "segments": [
          { "extracted": ["0", "2"], "source": ["0", "0"] },
          { "extracted": ["2", "4"], "source": ["0", "0"] }
        ]
      }
    },
    {
      "id": "literal-braces-are-not-interpolation",
      "family": "extraction",
      "input": { "kind": "literal", "text": "Total: {amount}" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{Total: \\{amount\\}}}",
        "parameters": []
      }
    },
    {
      "id": "literal-backslash",
      "family": "extraction",
      "input": { "kind": "literal", "text": "a\\b" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{a\\\\b}}",
        "parameters": []
      }
    },
    {
      "id": "literal-pipe-stays-unescaped",
      "family": "extraction",
      "input": { "kind": "literal", "text": "a|b" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{a|b}}",
        "parameters": []
      }
    },
    {
      "id": "literal-leading-whitespace-is-preserved",
      "family": "extraction",
      "input": { "kind": "literal", "text": "  indented" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{  indented}}",
        "parameters": []
      }
    },
    {
      "id": "literal-leading-period-is-not-a-declaration",
      "family": "extraction",
      "input": { "kind": "literal", "text": ".input looks like a keyword" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{.input looks like a keyword}}",
        "parameters": []
      }
    },
    {
      "id": "literal-newline-is-preserved-without-trimming",
      "family": "extraction",
      "input": { "kind": "literal", "text": "line one\nline two\n" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{line one\nline two\n}}",
        "parameters": []
      }
    },
    {
      "id": "literal-crlf-is-preserved",
      "family": "extraction",
      "input": { "kind": "literal", "text": "first\r\nsecond" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{first\r\nsecond}}",
        "parameters": []
      }
    },
    {
      "id": "literal-multibyte-maps-on-scalar-boundaries",
      "family": "extraction",
      "input": { "kind": "literal", "text": "日{本" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{日\\{本}}",
        "parameters": [],
        "segments": [
          { "extracted": ["0", "2"], "source": ["0", "0"] },
          { "extracted": ["2", "5"], "source": ["0", "3"] },
          { "extracted": ["5", "7"], "source": ["3", "4"] },
          { "extracted": ["7", "10"], "source": ["4", "7"] },
          { "extracted": ["10", "12"], "source": ["7", "7"] }
        ]
      }
    },
    {
      "id": "authored-mf2-is-its-own-extracted-form",
      "family": "extraction",
      "input": { "kind": "mf2", "text": "Hello {$name}!" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "Hello {$name}!",
        "parameters": ["name"],
        "segments": [{ "extracted": ["0", "14"], "source": ["0", "14"] }]
      }
    },
    {
      "id": "equal-cooked-content-analyses-identically",
      "family": "parser-ownership",
      "input": { "kind": "mf2", "text": "{{Pay now}}" },
      "expect": {
        "outcome": "understood",
        "mf2Source": "{{Pay now}}",
        "parameters": []
      }
    },
    {
      "id": "input-declaration-requires-its-name",
      "family": "parameters",
      "input": {
        "kind": "mf2",
        "text": ".input {$count :number}\n.match $count\none {{You have one message}}\n* {{You have {$count} messages}}"
      },
      "expect": {
        "outcome": "understood",
        "parameters": ["count"]
      }
    },
    {
      "id": "local-declarations-are-not-caller-parameters",
      "family": "parameters",
      "input": {
        "kind": "mf2",
        "text": ".local $greeting = {|hello|}\n{{{$greeting}}}"
      },
      "expect": {
        "outcome": "understood",
        "parameters": []
      }
    },
    {
      "id": "a-local-initialized-from-outside-still-requires-that-value",
      "family": "parameters",
      "input": {
        "kind": "mf2",
        "text": ".local $shown = {$raw :string}\n{{{$shown}}}"
      },
      "expect": {
        "outcome": "understood",
        "parameters": ["raw"]
      }
    },
    {
      "id": "parameter-names-are-sorted-by-unsigned-utf8-bytes",
      "family": "parameters",
      "input": { "kind": "mf2", "text": "{$zulu} {$alpha} {$Mike}" },
      "expect": {
        "outcome": "understood",
        "parameters": ["Mike", "alpha", "zulu"]
      }
    },
    {
      "id": "repeated-uses-collapse-to-one-requirement",
      "family": "parameters",
      "input": { "kind": "mf2", "text": "{$name} and {$name} again" },
      "expect": {
        "outcome": "understood",
        "parameters": ["name"]
      }
    },
    {
      "id": "syntax-failure-suppresses-dependent-work",
      "family": "parser-ownership",
      "input": { "kind": "mf2", "text": "Hello {$name" },
      "expect": {
        "outcome": "blocked",
        "mf2Source": "Hello {$name",
        "diagnosticCodes": ["unclosed-expression"]
      }
    },
    {
      "id": "semantic-failure-keeps-its-parser-owned-code",
      "family": "parser-ownership",
      "input": { "kind": "mf2", "text": ".input {$a}\n.input {$a}\n{{text}}" },
      "expect": {
        "outcome": "blocked",
        "diagnosticCodes": ["duplicate-declaration"]
      }
    },
    {
      "id": "missing-selector-annotation-is-a-semantic-failure",
      "family": "parser-ownership",
      "input": {
        "kind": "mf2",
        "text": ".match $count\none {{one}}\n* {{other}}"
      },
      "expect": {
        "outcome": "blocked",
        "diagnosticCodes": ["missing-selector-annotation"]
      }
    },
    {
      "id": "unrepresentable-scalar-is-an-operational-failure",
      "family": "extraction",
      "note": "The text is given as code points because JSON cannot carry a raw NUL and escaping it here would hide the very byte under test.",
      "input": { "kind": "literal", "textCodepoints": ["97", "0", "98"] },
      "expect": {
        "outcome": "failed",
        "failure": "unrepresentable-scalar",
        "offset": "1"
      }
    }
  ]
}
