{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Attribute": {
      "additionalProperties": false,
      "description": "One attribute, in its source order within the owning production.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": ["string", "null"]
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "AuthoringBasis": {
      "additionalProperties": false,
      "properties": {
        "authoringProfile": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "context": {
          "$ref": "#/definitions/ExactInputBinding"
        },
        "contextKind": {
          "$ref": "#/definitions/ContextKind"
        },
        "defaultSurfaceClass": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonemptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "localeCanonicalization": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "localeData": {
          "$ref": "#/definitions/LocaleData"
        },
        "surfaceVocabulary": {
          "$ref": "#/definitions/ExactInputBinding"
        }
      },
      "required": [
        "authoringProfile",
        "contextKind",
        "context",
        "surfaceVocabulary",
        "localeCanonicalization",
        "localeData"
      ],
      "type": "object"
    },
    "AuthoringInventory": {
      "additionalProperties": false,
      "description": "The declared scope of one analysis and what it found.\n\nDeserializing one reads its shape only. [`AuthoringInventory::validate`]\nchecks the structural rules, and admission checks the rest against a\ncontext; neither is implied by having decoded the bytes.",
      "properties": {
        "basis": {
          "$ref": "#/definitions/AuthoringBasis"
        },
        "completeness": {
          "$ref": "#/definitions/Completeness"
        },
        "declarations": {
          "items": {
            "$ref": "#/definitions/DeclarationFacts"
          },
          "type": "array"
        },
        "exclusions": {
          "items": {
            "$ref": "#/definitions/Exclusion"
          },
          "type": "array"
        },
        "owner": {
          "$ref": "#/definitions/OwnerIdentity"
        },
        "references": {
          "items": {
            "$ref": "#/definitions/ReferenceFacts"
          },
          "type": "array"
        },
        "scope": {
          "$ref": "#/definitions/Token"
        },
        "units": {
          "items": {
            "$ref": "#/definitions/UnitResult"
          },
          "type": "array"
        }
      },
      "required": [
        "owner",
        "scope",
        "basis",
        "completeness",
        "units",
        "declarations",
        "references",
        "exclusions"
      ],
      "type": "object"
    },
    "AuthoringSpecification": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/Design016"
        },
        "revision": {
          "$ref": "#/definitions/RevisionZero"
        }
      },
      "required": ["identity", "revision"],
      "type": "object"
    },
    "ByteRange": {
      "description": "One half-open UTF-8 byte range.\n\nEmpty insertion ranges and end-of-input positions are representable. A range\naddresses bytes, never Unicode scalar values or UTF-16 code units.",
      "properties": {
        "end": {
          "$ref": "#/definitions/UInt64"
        },
        "start": {
          "$ref": "#/definitions/UInt64"
        }
      },
      "required": ["start", "end"],
      "type": "object"
    },
    "CatchAllKey": {
      "additionalProperties": false,
      "description": "The catch-all key.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/CatchAllTag"
        }
      },
      "required": ["kind"],
      "type": "object"
    },
    "CatchAllTag": {
      "description": "Discriminator of a catch-all key.",
      "enum": ["catch-all"],
      "type": "string"
    },
    "Completeness": {
      "description": "Whether an inventory covers the whole of its declared scope.\n\nThis describes what the caller declared it was analyzing. It is checked\nagainst the caller's expected membership, and it does not change when a\nunit inside that scope fails.",
      "oneOf": [
        {
          "const": "complete",
          "description": "The inventory covers the whole declared scope.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "The inventory is a smaller view, such as an editor request.",
          "type": "string"
        }
      ]
    },
    "ContextKind": {
      "description": "Which kind of owning input a basis was resolved against.\n\nThe three kinds are not interchangeable. A test context exercises the\ndeclared subset; it never becomes checked production evidence by being\nspelled differently.",
      "enum": ["application-profile", "library-context", "test-context"],
      "type": "string"
    },
    "Declaration": {
      "anyOf": [
        {
          "$ref": "#/definitions/InputDeclaration"
        },
        {
          "$ref": "#/definitions/LocalDeclaration"
        }
      ],
      "description": "One declaration, in source order."
    },
    "DeclarationFacts": {
      "additionalProperties": false,
      "description": "The checked facts for one declaration.\n\nThese serialize as design 017's `DeclarationFacts`. Deserializing one only\nreads its shape; whether it is consistent with its source, its context and\nthe inventory around it is decided by inventory admission.",
      "properties": {
        "extractionMap": {
          "items": {
            "$ref": "#/definitions/ExtractionSegment"
          },
          "type": "array"
        },
        "mf2Source": {
          "type": "string"
        },
        "occurrence": {
          "$ref": "#/definitions/Occurrence"
        },
        "projection": {
          "$ref": "#/definitions/IntentProjection"
        },
        "sourceLocaleBasis": {
          "$ref": "#/definitions/SourceLocaleBasis"
        },
        "surfaceClass": {
          "$ref": "#/definitions/NonemptyText"
        }
      },
      "required": [
        "occurrence",
        "mf2Source",
        "projection",
        "sourceLocaleBasis",
        "surfaceClass",
        "extractionMap"
      ],
      "type": "object"
    },
    "Design016": {
      "enum": ["intlify-design-016"],
      "type": "string"
    },
    "ExactInputBinding": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
        "revision": {
          "$ref": "#/definitions/Token"
        },
        "semanticDigest": {
          "$ref": "#/definitions/IntegrityDigest"
        }
      },
      "required": ["identity", "revision", "semanticDigest"],
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "description": "One value the author explicitly excluded from localization.",
      "properties": {
        "occurrence": {
          "$ref": "#/definitions/Occurrence"
        },
        "reason": {
          "$ref": "#/definitions/NonemptyText"
        }
      },
      "required": ["occurrence", "reason"],
      "type": "object"
    },
    "Expression": {
      "additionalProperties": false,
      "description": "One expression: an operand, a function, or both.\n\nAn expression with neither is not representable, matching the MF2 grammar.",
      "properties": {
        "attributes": {
          "items": {
            "$ref": "#/definitions/Attribute"
          },
          "type": "array"
        },
        "function": {
          "anyOf": [
            {
              "$ref": "#/definitions/Function"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/definitions/ExpressionTag"
        },
        "operand": {
          "anyOf": [
            {
              "$ref": "#/definitions/Value"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["kind", "attributes"],
      "type": "object"
    },
    "ExpressionTag": {
      "description": "Discriminator of an expression.",
      "enum": ["expression"],
      "type": "string"
    },
    "ExtractionSegment": {
      "additionalProperties": false,
      "description": "One contiguous correspondence between emitted MF2 bytes and source bytes.\n\nSegments are ordered by their extracted start, do not overlap, and together\ncover every emitted byte. A source range may repeat, may be zero-width for a\ngenerated delimiter, and may cover fewer bytes than the emitted run it maps\nto. Equal lengths never by themselves assert a byte-for-byte correspondence.",
      "properties": {
        "extracted": {
          "$ref": "#/definitions/ByteRange"
        },
        "source": {
          "$ref": "#/definitions/ByteRange"
        }
      },
      "required": ["extracted", "source"],
      "type": "object"
    },
    "Function": {
      "additionalProperties": false,
      "description": "One function reference and its options.\n\nThe options are symbolic requirements. This projection encodes no second\nruntime type system and asserts nothing about what the function computes.",
      "properties": {
        "name": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/definitions/Opt"
          },
          "type": "array"
        }
      },
      "required": ["name", "options"],
      "type": "object"
    },
    "InputDeclaration": {
      "additionalProperties": false,
      "description": "One `.input` declaration.",
      "properties": {
        "attributes": {
          "items": {
            "$ref": "#/definitions/Attribute"
          },
          "type": "array"
        },
        "function": {
          "anyOf": [
            {
              "$ref": "#/definitions/Function"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/definitions/InputTag"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["kind", "name", "attributes"],
      "type": "object"
    },
    "InputTag": {
      "description": "Discriminator of an input declaration.",
      "enum": ["input"],
      "type": "string"
    },
    "IntegrityDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "IntentProjection": {
      "additionalProperties": false,
      "description": "The complete localization-relevant projection of one declaration.\n\nEqual projections mean equal localization semantics. Host source\ncoordinates, quote spelling, non-semantic trivia, reference counts, and\nparameter-expression implementation are deliberately absent, so formatting\nthat leaves both the parsed structure and literal content unchanged cannot\nchange a revision.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonemptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "$ref": "#/definitions/MessageProjection"
        },
        "mf2Specification": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sourceLocale": {
          "$ref": "#/definitions/NonemptyText"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["mf2Specification", "message", "sourceLocale", "parameters"],
      "type": "object"
    },
    "InventoryKind": {
      "enum": ["authoring-inventory"],
      "type": "string"
    },
    "LiteralKey": {
      "additionalProperties": false,
      "description": "One matcher variant key.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/LiteralTag"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"],
      "type": "object"
    },
    "LiteralTag": {
      "description": "Discriminator of a literal value.",
      "enum": ["literal"],
      "type": "string"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "description": "One literal value, after MF2 escape decoding.\n\nQuoted and unquoted spellings with equal decoded values are the same value.\nA numeric-looking literal stays a string: there is no host number\nconversion, trimming, whitespace compression, or Unicode normalization of\nliteral content anywhere in this projection.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/LiteralTag"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"],
      "type": "object"
    },
    "LocalDeclaration": {
      "additionalProperties": false,
      "description": "One `.local` declaration.",
      "properties": {
        "expression": {
          "$ref": "#/definitions/Expression"
        },
        "kind": {
          "$ref": "#/definitions/LocalTag"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["kind", "name", "expression"],
      "type": "object"
    },
    "LocalTag": {
      "description": "Discriminator of a local declaration.",
      "enum": ["local"],
      "type": "string"
    },
    "LocaleData": {
      "additionalProperties": false,
      "description": "The locale data a canonicalization was performed against.",
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
        "semanticDigest": {
          "$ref": "#/definitions/IntegrityDigest"
        }
      },
      "required": ["identity", "semanticDigest"],
      "type": "object"
    },
    "MarkupForm": {
      "description": "Which side of a markup pair a part represents.",
      "enum": ["open", "close", "standalone"],
      "type": "string"
    },
    "MarkupPart": {
      "additionalProperties": false,
      "description": "One markup part.",
      "properties": {
        "attributes": {
          "items": {
            "$ref": "#/definitions/Attribute"
          },
          "type": "array"
        },
        "form": {
          "$ref": "#/definitions/MarkupForm"
        },
        "kind": {
          "$ref": "#/definitions/MarkupTag"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/definitions/Opt"
          },
          "type": "array"
        }
      },
      "required": ["kind", "form", "name", "options", "attributes"],
      "type": "object"
    },
    "MarkupTag": {
      "description": "Discriminator of a markup part.",
      "enum": ["markup"],
      "type": "string"
    },
    "MatchBody": {
      "additionalProperties": false,
      "description": "A message that selects among variants.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/MatchTag"
        },
        "selectors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "variants": {
          "items": {
            "$ref": "#/definitions/Variant"
          },
          "type": "array"
        }
      },
      "required": ["kind", "selectors", "variants"],
      "type": "object"
    },
    "MatchTag": {
      "description": "Discriminator of a matcher body.",
      "enum": ["match"],
      "type": "string"
    },
    "MessageBody": {
      "anyOf": [
        {
          "$ref": "#/definitions/PatternBody"
        },
        {
          "$ref": "#/definitions/MatchBody"
        }
      ],
      "description": "The body of a message.\n\nA simple message and a quoted pattern with equal content produce the same\nbody: the wrapper is syntax, not structure."
    },
    "MessageProjection": {
      "additionalProperties": false,
      "description": "The structured message.",
      "properties": {
        "body": {
          "$ref": "#/definitions/MessageBody"
        },
        "declarations": {
          "items": {
            "$ref": "#/definitions/Declaration"
          },
          "type": "array"
        }
      },
      "required": ["declarations", "body"],
      "type": "object"
    },
    "NonemptyText": {
      "pattern": "^[\\s\\S]+$",
      "type": "string"
    },
    "Occurrence": {
      "additionalProperties": false,
      "properties": {
        "range": {
          "$ref": "#/definitions/ByteRange"
        },
        "role": {
          "$ref": "#/definitions/OccurrenceRole"
        },
        "source": {
          "$ref": "#/definitions/SourceSnapshot"
        }
      },
      "required": ["source", "range", "role"],
      "type": "object"
    },
    "OccurrenceRole": {
      "description": "The syntax role an occurrence plays in its source unit.\n\nDeclaration facts admit only the three declaration roles. The remaining\nroles describe use sites, parameter expressions, and explicit exclusions.",
      "enum": [
        "ui-literal",
        "intent-literal",
        "mf2-declaration",
        "reference",
        "parameter-expression",
        "exclusion"
      ],
      "type": "string"
    },
    "Opt": {
      "additionalProperties": false,
      "description": "One function option, in its source order within the owning function.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Value"
        }
      },
      "required": ["name", "value"],
      "type": "object"
    },
    "OwnerIdentity": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/Token"
        },
        "kind": {
          "$ref": "#/definitions/OwnerKind"
        }
      },
      "required": ["kind", "identity"],
      "type": "object"
    },
    "OwnerKind": {
      "description": "Which owner domain an identity belongs to.\n\nThe same identity token under the two kinds denotes different owners.\nSpelling is not proof of publisher identity or authorization.",
      "enum": ["application", "library"],
      "type": "string"
    },
    "ParameterBinding": {
      "additionalProperties": false,
      "description": "One parameter the host supplied at a use site.",
      "properties": {
        "expression": {
          "$ref": "#/definitions/Occurrence"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["name", "expression"],
      "type": "object"
    },
    "PatternBody": {
      "additionalProperties": false,
      "description": "A message with one pattern.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/PatternTag"
        },
        "parts": {
          "items": {
            "$ref": "#/definitions/PatternPart"
          },
          "type": "array"
        }
      },
      "required": ["kind", "parts"],
      "type": "object"
    },
    "PatternPart": {
      "anyOf": [
        {
          "$ref": "#/definitions/TextPart"
        },
        {
          "$ref": "#/definitions/Expression"
        },
        {
          "$ref": "#/definitions/MarkupPart"
        }
      ],
      "description": "One element of a pattern, in source order."
    },
    "PatternTag": {
      "description": "Discriminator of a pattern body.",
      "enum": ["pattern"],
      "type": "string"
    },
    "ReferenceFacts": {
      "additionalProperties": false,
      "description": "One use site and the declarations it may use.\n\nThe declarations are a finite set: the first reference form names one or\nmore declarations in the same inventory, and a later extension may name\nseveral. The parameters keep the host's evaluation order, because that is\nthe order a later lowering has to preserve.",
      "properties": {
        "declarations": {
          "items": {
            "$ref": "#/definitions/Occurrence"
          },
          "type": "array"
        },
        "occurrence": {
          "$ref": "#/definitions/Occurrence"
        },
        "parameters": {
          "items": {
            "$ref": "#/definitions/ParameterBinding"
          },
          "type": "array"
        }
      },
      "required": ["occurrence", "declarations", "parameters"],
      "type": "object"
    },
    "RevisionZero": {
      "enum": ["0"],
      "type": "string"
    },
    "SourceLocaleBasis": {
      "description": "Which basis established a declaration's source locale.\n\nSwitching between the two with the same canonical locale does not change a\nrevision, so the basis is retained as evidence rather than folded into the\nprojection.",
      "enum": ["explicit", "context-default"],
      "type": "string"
    },
    "SourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "#/definitions/UInt64"
        },
        "grammar": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "owner": {
          "$ref": "#/definitions/OwnerIdentity"
        },
        "revision": {
          "$ref": "#/definitions/Token"
        },
        "unit": {
          "$ref": "#/definitions/Token"
        },
        "utf8Digest": {
          "$ref": "#/definitions/IntegrityDigest"
        }
      },
      "required": ["owner", "unit", "revision", "grammar", "byteLength", "utf8Digest"],
      "type": "object"
    },
    "TextPart": {
      "additionalProperties": false,
      "description": "One run of literal text.\n\nAdjacent runs are merged and empty runs are omitted, so a text part always\ncarries content and two equal messages cannot differ by how the parser\nhappened to split their text.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/TextTag"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"],
      "type": "object"
    },
    "TextTag": {
      "description": "Discriminator of a literal text run.",
      "enum": ["text"],
      "type": "string"
    },
    "Token": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "type": "string"
    },
    "UInt64": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "UnitOutcome": {
      "description": "What happened to one source unit.",
      "oneOf": [
        {
          "const": "checked",
          "description": "Every occurrence in the unit was classified and resolved.",
          "type": "string"
        },
        {
          "const": "blocked",
          "description": "The unit was read, and at least one of its occurrences was blocked.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The unit could not be read at all, so it establishes no facts.",
          "type": "string"
        }
      ]
    },
    "UnitResult": {
      "additionalProperties": false,
      "description": "One source unit in an inventory and what happened to it.",
      "properties": {
        "outcome": {
          "$ref": "#/definitions/UnitOutcome"
        },
        "source": {
          "$ref": "#/definitions/SourceSnapshot"
        }
      },
      "required": ["source", "outcome"],
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "The bounded semantic usage a declaration was proven to have.",
      "properties": {
        "profile": {
          "$ref": "#/definitions/VersionedIdentity"
        },
        "value": {
          "$ref": "#/definitions/NonemptyText"
        }
      },
      "required": ["profile", "value"],
      "type": "object"
    },
    "Value": {
      "anyOf": [
        {
          "$ref": "#/definitions/LiteralValue"
        },
        {
          "$ref": "#/definitions/VariableValue"
        }
      ],
      "description": "An operand or option value."
    },
    "VariableTag": {
      "description": "Discriminator of a variable reference.",
      "enum": ["variable"],
      "type": "string"
    },
    "VariableValue": {
      "additionalProperties": false,
      "description": "One variable reference, by its parser-owned semantic name without a sigil.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/VariableTag"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["kind", "name"],
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "description": "One matcher variant, in source order.",
      "properties": {
        "keys": {
          "items": {
